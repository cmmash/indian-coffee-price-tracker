<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Indian Specialty Coffee Price Tracker</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1>Indian Specialty Coffee Price Tracker</h1>
    <p>Whole bean coffees from 25+ Indian roasters</p>
  </header>

  <main>
    <section class="filters">
      <h2>Filters</h2>
      <form method="GET" action="/">
        <div class="filter-row">
          <select name="roaster">
            <option value="">All Roasters</option>
            <% roasters.forEach(r => { %>
              <option value="<%= r %>" <%= filters.roaster === r ? 'selected' : '' %>><%= r %></option>
            <% }) %>
          </select>

          <select name="roast">
            <option value="">All Roast Levels</option>
            <% roasts.forEach(r => { %>
              <option value="<%= r %>" <%= filters.roast === r ? 'selected' : '' %>><%= r %></option>
            <% }) %>
          </select>

          <select name="process">
            <option value="">All Processing Methods</option>
            <% processes.forEach(p => { %>
              <option value="<%= p %>" <%= filters.process === p ? 'selected' : '' %>><%= p %></option>
            <% }) %>
          </select>

          <select name="sort">
            <option value="">Sort by...</option>
            <option value="price_asc" <%= filters.sort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
            <option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
            <option value="price_per_100g" <%= filters.sort === 'price_per_100g' ? 'selected' : '' %>>Price per 100g</option>
            <option value="name" <%= filters.sort === 'name' ? 'selected' : '' %>>Name</option>
            <option value="roaster" <%= filters.sort === 'roaster' ? 'selected' : '' %>>Roaster</option>
          </select>
        </div>

        <div class="filter-row">
          <input type="number" name="minPrice" placeholder="Min Price (₹)" value="<%= filters.minPrice || '' %>">
          <input type="number" name="maxPrice" placeholder="Max Price (₹)" value="<%= filters.maxPrice || '' %>">
          <button type="submit">Apply Filters</button>
          <a href="/" class="btn-reset">Reset</a>
        </div>
      </form>
    </section>

    <section class="results">
      <h2><%= coffees.length %> Coffees Found</h2>
      
      <div class="coffee-grid">
        <% coffees.forEach(coffee => { %>
          <div class="coffee-card">
            <h3><%= coffee.name %></h3>
            <p class="roaster"><%= coffee.roaster %></p>
            <p class="price">₹<%= coffee.price_inr %> <span class="weight">(<%= coffee.weight_grams %>g)</span></p>
            <p class="price-per-100g">₹<%= coffee.price_per_100g %>/100g</p>
            
            <div class="details">
              <% if (coffee.origin_estate && coffee.origin_estate !== 'Unknown') { %>
                <span class="tag origin"><%= coffee.origin_estate %></span>
              <% } %>
              <% if (coffee.roast_level && coffee.roast_level !== 'Unknown') { %>
                <span class="tag roast"><%= coffee.roast_level %></span>
              <% } %>
              <% if (coffee.processing_method && coffee.processing_method !== 'Unknown') { %>
                <span class="tag process"><%= coffee.processing_method %></span>
              <% } %>
            </div>
            
            <a href="<%= coffee.product_url %>" target="_blank" class="btn-buy">View Product</a>
          </div>
        <% }) %>
      </div>
    </section>
  </main>

  <footer>
    <p>Data scraped on <%= new Date().toLocaleDateString() %></p>
    <p><a href="/api/coffees">API</a> | <a href="/api/stats">Stats</a></p>
  </footer>
</body>
</html>
