<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Indian Specialty Coffee Price Tracker</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <div class="container">
      <h1>☕ Indian Specialty Coffee Price Tracker</h1>
      <p>Track prices from 23+ Indian coffee roasters</p>
    </div>
  </header>

  <main class="container">
    <!-- Stats -->
    <section class="stats">
      <div class="stat-card">
        <h3><%= stats.total_coffees %></h3>
        <p>Coffees Tracked</p>
      </div>
      <div class="stat-card">
        <h3><%= stats.total_roasters %></h3>
        <p>Roasters</p>
      </div>
      <div class="stat-card">
        <h3>₹<%= Math.round(stats.avg_price) %></h3>
        <p>Avg per 100g</p>
      </div>
      <div class="stat-card">
        <h3>₹<%= stats.min_price %> - ₹<%= stats.max_price %></h3>
        <p>Price Range</p>
      </div>
    </section>

    <!-- Filters -->
    <section class="filters">
      <h2>Filter Coffees</h2>
      <form id="filterForm">
        <div class="filter-row">
          <select name="roaster" id="roasterFilter">
            <option value="">All Roasters</option>
            <% roasters.forEach(r => { %>
              <option value="<%= r.roaster %>"><%= r.roaster %> (<%= r.coffee_count %>)</option>
            <% }) %>
          </select>
          
          <select name="roast_level" id="roastFilter">
            <option value="">All Roast Levels</option>
            <option value="Light">Light</option>
            <option value="Medium">Medium</option>
            <option value="Medium-Dark">Medium-Dark</option>
            <option value="Dark">Dark</option>
          </select>
          
          <select name="processing" id="processingFilter">
            <option value="">All Processing</option>
            <option value="Washed">Washed</option>
            <option value="Natural">Natural</option>
            <option value="Honey">Honey</option>
            <option value="Anaerobic">Anaerobic</option>
          </select>
          
          <input type="text" name="search" id="searchInput" placeholder="Search coffees...">
          
          <button type="submit">Apply Filters</button>
          <button type="button" onclick="resetFilters()">Reset</button>
        </div>
      </form>
    </section>

    <!-- Coffee Grid -->
    <section class="coffee-grid" id="coffeeGrid">
      <% recentCoffees.forEach(coffee => { %>
        <div class="coffee-card">
          <div class="coffee-header">
            <h3><%= coffee.name %></h3>
            <span class="roaster-badge"><%= coffee.roaster %></span>
          </div>
          <div class="coffee-details">
            <p><strong>Origin:</strong> <%= coffee.origin_estate || 'N/A' %></p>
            <p><strong>Roast:</strong> <%= coffee.roast_level || 'N/A' %></p>
            <p><strong>Process:</strong> <%= coffee.processing_method || 'N/A' %></p>
            <p><strong>Variety:</strong> <%= coffee.variety || 'N/A' %></p>
          </div>
          <div class="coffee-price">
            <span class="price">₹<%= coffee.price_inr %></span>
            <span class="weight">for <%= coffee.weight_grams %>g</span>
            <span class="price-per-100g">₹<%= coffee.price_per_100g %>/100g</span>
          </div>
          <a href="<%= coffee.product_url %>" target="_blank" class="btn-primary">View Product</a>
        </div>
      <% }) %>
    </section>
  </main>

  <footer>
    <div class="container">
      <p>Data last updated: <%= new Date().toLocaleDateString() %></p>
      <p>Built with ☕ for the Indian coffee community</p>
    </div>
  </footer>

  <script>
    // Filter functionality
    document.getElementById('filterForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      await loadCoffees();
    });

    async function loadCoffees() {
      const roaster = document.getElementById('roasterFilter').value;
      const roast = document.getElementById('roastFilter').value;
      const processing = document.getElementById('processingFilter').value;
      const search = document.getElementById('searchInput').value;
      
      const params = new URLSearchParams();
      if (roaster) params.append('roaster', roaster);
      if (roast) params.append('roast_level', roast);
      if (processing) params.append('processing', processing);
      if (search) params.append('search', search);
      
      const res = await fetch('/api/coffees?' + params.toString());
      const coffees = await res.json();
      
      const grid = document.getElementById('coffeeGrid');
      grid.innerHTML = coffees.map(c => `
        <div class="coffee-card">
          <div class="coffee-header">
            <h3>${c.name}</h3>
            <span class="roaster-badge">${c.roaster}</span>
          </div>
          <div class="coffee-details">
            <p><strong>Origin:</strong> ${c.origin_estate || 'N/A'}</p>
            <p><strong>Roast:</strong> ${c.roast_level || 'N/A'}</p>
            <p><strong>Process:</strong> ${c.processing_method || 'N/A'}</p>
            <p><strong>Variety:</strong> ${c.variety || 'N/A'}</p>
          </div>
          <div class="coffee-price">
            <span class="price">₹${c.price_inr}</span>
            <span class="weight">for ${c.weight_grams}g</span>
            <span class="price-per-100g">₹${c.price_per_100g}/100g</span>
          </div>
          <a href="${c.product_url}" target="_blank" class="btn-primary">View Product</a>
        </div>
      `).join('');
    }

    function resetFilters() {
      document.getElementById('filterForm').reset();
      loadCoffees();
    }
  </script>
</body>
</html>
